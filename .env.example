# ── Email (form submissions) ─────────────────────────────────────
# API key for Resend (https://resend.com). With no key set, submissions
# are logged to the server console instead of emailed — nothing is lost
# in development.
RESEND_API_KEY=

# Where form submissions are delivered (the owner's inbox).
OWNER_EMAIL=owner@ascendseniorconsulting.com

# The From address on submission emails. Must be a verified sender/domain
# in your email provider. Falls back to Resend's onboarding sender.
EMAIL_FROM="Ascend Website <forms@ascendseniorconsulting.com>"

# ── Public values (inlined into the client bundle at build) ──────
# Owner email displayed on the site (footer, contact page).
NEXT_PUBLIC_OWNER_EMAIL=owner@ascendseniorconsulting.com

# Canonical site URL — used for SEO metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=https://ascendseniorconsulting.com

# Optional: an embeddable scheduler URL. When set, the Book page shows
# the live calendar instead of the request form.
NEXT_PUBLIC_SCHEDULER_URL=

# ── Stripe Checkout ──────────────────────────────────────────────
# With no secret key set, the shop hides card checkout and offers the
# order-request flow only. The site never breaks undeployed.
STRIPE_SECRET_KEY=

# Signing secret for the /api/stripe/webhook endpoint. In local testing
# this is printed by `stripe listen` (see README).
STRIPE_WEBHOOK_SECRET=

# Signs the tokenized facility-intake links emailed after payment.
# Use a long random value: openssl rand -base64 32
INTAKE_TOKEN_SECRET=

# Sales tax. Leave OFF until MN sales tax registration and Stripe Tax
# settings are in place — see the README before flipping this to true.
ENABLE_STRIPE_TAX=false
